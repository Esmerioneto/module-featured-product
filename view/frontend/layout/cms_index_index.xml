<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Egsn\FeaturedProduct\Block\FeaturedProduct"
                   name="egsn.featured.product"
                   template="Egsn_FeaturedProduct::featured-product.phtml"
                   before="-">
                <arguments>
                    <argument name="image_id" xsi:type="string">product_base_image</argument>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="egsnFeaturedProductStock" xsi:type="array">
                                <item name="component" xsi:type="string">Egsn_FeaturedProduct/js/view/stock</item>
                                <item name="config" xsi:type="array">
                                    <item name="template" xsi:type="string">Egsn_FeaturedProduct/stock</item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
